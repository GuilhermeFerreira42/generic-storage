@"
# Dependencies
node_modules/
.venv/
venv/

# Build outputs
dist/
build/
target/
out/
coverage/

# Test/cache outputs
.vite/
.vitest/
.nyc_output/
.cache/
.turbo/
htmlcov/
.coverage
*.tsbuildinfo

# Runtime/database artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
*.tmp
*.swp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment/secrets
.env
.env.local
.env.*
!.env.example

# Local agent/workflow folders
.agent/
.claude/


# Editors/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python cache
*.pyc
__pycache__/
"@ | Set-Content ".gitignore" -Encoding UTF8