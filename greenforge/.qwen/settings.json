{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook SessionStart",
            "cwd": "${extensionPath}",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook SessionEnd",
            "cwd": "${extensionPath}",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook UserPromptSubmit",
            "cwd": "${extensionPath}",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|WriteFile|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook PreToolUse",
            "cwd": "${extensionPath}",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook PostToolUse",
            "cwd": "${extensionPath}",
            "timeout": 3000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook SubagentStart",
            "cwd": "${extensionPath}",
            "timeout": 3000
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/index.js hook SubagentStop",
            "cwd": "${extensionPath}",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "$version": 4
}