{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "greenforge-init", "timeout": 5000 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "greenforge-cleanup", "timeout": 3000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "http", "url": "http://localhost:7777/prompt-submit", "timeout": 2000 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|WriteFile|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "http", "url": "http://localhost:7777/pre-tool", "timeout": 5000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "http", "url": "http://localhost:7777/post-tool", "timeout": 3000 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "http", "url": "http://localhost:7777/subagent-start", "timeout": 3000 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "http", "url": "http://localhost:7777/subagent-stop", "timeout": 3000 }
        ]
      }
    ]
  }
}
